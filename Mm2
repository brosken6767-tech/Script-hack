-- Защита от повторного запуска
if _G.MM2RayfieldLoaded then
    local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
    Rayfield:Notify({
        Title = "MM2 Скрипт",
        Content = "Интерфейс уже открыт!",
        Duration = 3
    })
    return
end
_G.MM2RayfieldLoaded = true

-- Загрузка библиотеки Rayfield UI
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
    Name = "MM2 Delta Hub",
    LoadingTitle = "Загрузка MM2 Скрипта...",
    LoadingSubtitle = "by Assistant",
    ConfigurationSaving = {
        Enabled = false,
    },
    Discord = {
        Enabled = false,
    },
    KeySystem = false,
})

-- Создаем вкладку
local MainTab = Window:CreateTab("Главная", 4483362458)

-- Переменные для работы функций
local ESPEnabled = false
local GunTeleportEnabled = false
local AimbotEnabled = false
local HitboxEnabled = false

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local lastPos = nil
local hasTeleportedToGun = false

-- 1. Секция ESP и Телепорта к пистолету
MainTab:CreateSection("ESP и Оружие")

MainTab:CreateToggle({
    Name = "ESP Ролей (Убийца, Шериф, Иннокент)",
    CurrentValue = false,
    Flag = "ESP_Toggle",
    Callback = function(Value)
        ESPEnabled = Value
        if not Value then
            for _, player in ipairs(Players:GetPlayers()) do
                if player.Character and player.Character:FindFirstChild("MM2_Highlight") then
                    player.Character.MM2_Highlight:Destroy()
                end
            end
        end
    end,
})

MainTab:CreateToggle({
    Name = "Авто-ТП к пистолету (и обратно)",
    CurrentValue = false,
    Flag = "GunTP_Toggle",
    Callback = function(Value)
        GunTeleportEnabled = Value
        if not Value then
            hasTeleportedToGun = false
            lastPos = nil
        end
    end,
})

-- 2. Секция Аимбота
MainTab:CreateSection("Боевые функции")

MainTab:CreateToggle({
    Name = "Аимбот строго на Убийцу",
    CurrentValue = false,
    Flag = "Aimbot_Toggle",
    Callback = function(Value)
        AimbotEnabled = Value
    end,
})

-- 3. Секция Хитбоксов (Увеличение голов)
MainTab:CreateSection("Увеличение голов (Hitboxes)")

MainTab:CreateToggle({
    Name = "Увеличение голов (Все роли в 5 раз)",
    CurrentValue = false,
    Flag = "Hitbox_Toggle",
    Callback = function(Value)
        HitboxEnabled = Value
        if not Value then
            for _, player in ipairs(Players:GetPlayers()) do
                if player.Character and player.Character:FindFirstChild("Head") then
                    player.Character.Head.Size = Vector3.new(2, 1, 1)
                    player.Character.Head.Transparency = 0
                    player.Character.Head.CanCollide = true
                end
            end
        end
    end,
})

-- Логика выполнения (потоки)

RunService.RenderStepped:Connect(function()
    -- ESP Ролей
    if ESPEnabled then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local character = player.Character
                local highlight = character:FindFirstChild("MM2_Highlight")
                
                local role = "Innocent"
                local backpack = player:FindFirstChild("Backpack")
                
                if (character:FindFirstChild("Knife") or (backpack and backpack:FindFirstChild("Knife"))) then
                    role = "Murderer"
                elseif (character:FindFirstChild("Gun") or (backpack and backpack:FindFirstChild("Gun"))) then
                    role = "Sheriff"
                end

                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Name = "MM2_Highlight"
                    highlight.Parent = character
                    highlight.FillTransparency = 0.5
                end

                if role == "Murderer" then
                    highlight.FillColor = Color3.fromRGB(255, 0, 0) -- Красный
                elseif role == "Sheriff" then
                    highlight.FillColor = Color3.fromRGB(0, 0, 255) -- Синий
                else
                    highlight.FillColor = Color3.fromRGB(0, 255, 0) -- Зеленый
                end
            end
        end
    end

    -- Телепорт к выпавшему пистолету
    if GunTeleportEnabled then
        local rootPart = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if rootPart then
            local gunDrop = nil
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj.Name == "GunDrop" then
                    gunDrop = obj
                    break
                end
            end
            
            if gunDrop then
                if not hasTeleportedToGun then
                    lastPos = rootPart.CFrame
                    rootPart.CFrame = gunDrop.CFrame
                    hasTeleportedToGun = true
                end
            else
                if hasTeleportedToGun and lastPos then
                    rootPart.CFrame = lastPos
                    hasTeleportedToGun = false
                    lastPos = nil
                end
            end
        end
    end
end)

-- Поток для Аимбота: наводит камеру строго на Убийцу
RunService.RenderStepped:Connect(function()
    if AimbotEnabled then
        local camera = Workspace.CurrentCamera
        local murdererHead = nil
        
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local character = player.Character
                local backpack = player:FindFirstChild("Backpack")
                
                -- Ищем игрока у которого в руках или в рюкзаке есть нож (Убийца)
                if character:FindFirstChild("Knife") or (backpack and backpack:FindFirstChild("Knife")) then
                    if character:FindFirstChild("Head") then
                        murdererHead = character.Head
                        break
                    end
                end
            end
        end
        
        -- Если убийца найден на карте, наводим камеру на его голову
        if murdererHead then
            camera.CFrame = CFrame.new(camera.CFrame.Position, murdererHead.Position)
        end
    end
end)

-- Поток для Хитбоксов (все головы увеличены в 5 раз)
RunService.Heartbeat:Connect(function()
    if HitboxEnabled then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local head = player.Character:FindFirstChild("Head")
                if head then
                    head.Size = Vector3.new(10, 10, 10) -- Голова увеличена в 5 раз
                    head.Transparency = 0.7
                    head.CanCollide = false
                end
            end
        end
    end
end)

Rayfield:Notify({
    Title = "MM2 Hub Запущен!",
    Content = "Аимбот настроен на поиск Убийцы.",
    Duration = 5
})
