local function startFly()
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local lv = Instance.new("LinearVelocity", hrp)
    lv.Name = "FlyVelocity"
    lv.MaxForce = 999999999
    lv.VectorVelocity = Vector3.new(0, 0, 0)
    
    local att = Instance.new("Attachment", hrp)
    att.Name = "FlyAttachment"
    lv.Attachment0 = att
    
    RunService.RenderStepped:Connect(function()
        if FlyEnabled and hrp then
            local moveDir = Vector3.new(0,0,0)
            local camCF = Camera.CFrame
            local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                moveDir = (camCF.LookVector * hum.MoveDirection.Z) + (camCF.RightVector * hum.MoveDirection.X)
                moveDir = moveDir.Unit * FlySpeed
            end
            lv.VectorVelocity = moveDir + Vector3.new(0, 5, 0)
        else
            if hrp:FindFirstChild("FlyVelocity") then hrp.FlyVelocity:Destroy() end
            if hrp:FindFirstChild("FlyAttachment") then hrp.FlyAttachment:Destroy() end
        end
    end)
end

