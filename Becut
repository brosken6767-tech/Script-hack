local function createTabButton(text, pageToShow)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 40)
    btn.BackgroundColor3 = Color3.fromRGB(25, 22, 38)
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(180, 170, 210)
